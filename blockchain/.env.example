# ==============================================================================
# CyberShield AI — Member 3 Blockchain Module Environment Configuration
# NOTE: All values are placeholders. Do NOT commit real private keys or secrets.
# ==============================================================================

# Blockchain RPC Provider URL (default: Hardhat local node)
BLOCKCHAIN_RPC_URL=http://127.0.0.1:8545

# Deployed ThreatReportRegistry Contract Address
REGISTRY_CONTRACT_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3

# Signer / Deployer Private Key (Hex-encoded 32-byte key without quotes)
# Supported by both Hardhat and Python BlockchainService.
# For local Hardhat dev, this can remain blank to use node default accounts.
BLOCKCHAIN_PRIVATE_KEY=
DEPLOYER_PRIVATE_KEY=

# Chain ID (31337 for Hardhat localhost, 11155111 for Sepolia)
CHAIN_ID=31337

# Testnet RPC URLs (Optional for public testnet deployment)
SEPOLIA_RPC_URL=
POLYGON_AMOY_RPC_URL=
