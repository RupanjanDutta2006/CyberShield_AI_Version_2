# ==============================================================================
# CyberShield AI — Unified Environment Configuration Template
# Copy this file to '.env' and populate with your local values/secrets.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Server Core Configuration
# ------------------------------------------------------------------------------
APP_ENV=development
APP_DEBUG=true
PORT=8000
HOST=127.0.0.1
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000"]

# ------------------------------------------------------------------------------
# 2. Security & Authentication
# ------------------------------------------------------------------------------
# API Key for authenticated endpoints (Part 19/20 persistence & register)
CYBERSHIELD_API_KEY=cybershield-auth-key-2026
AUTH_SECRET_KEY=cybershield-auth-key-2026
AUTH_ALLOWED_KEYS=["cybershield-auth-key-2026"]

# ------------------------------------------------------------------------------
# 3. Database Persistence
# ------------------------------------------------------------------------------
# SQLite default; PostgreSQL format: postgresql://user:pass@localhost:5432/cybershield
DATABASE_URL=sqlite:///./cyber_shield.db

# ------------------------------------------------------------------------------
# 4. AI Scam Analyzer Engine (Member 2 Multi-Provider Failover)
# ------------------------------------------------------------------------------
# Tier 1: Groq Cloud (Llama 3.3 70B / 8B high-speed inference)
GROQ_API_KEY=your_groq_api_key_here

# Tier 2: Google Gemini (Gemini 1.5 Flash)
GEMINI_API_KEY=your_gemini_api_key_here

# Tier 3: OpenAI (GPT-4o mini)
OPENAI_API_KEY=your_openai_api_key_here

# Active Primary Engine (groq, gemini, openai, or local_heuristic)
AI_PRIMARY_PROVIDER=groq

# ------------------------------------------------------------------------------
# 5. Threat Intelligence Feeds (Member 1 & Member 4)
# ------------------------------------------------------------------------------
URLHAUS_API_KEY=your_urlhaus_api_key_here
PHISHTANK_API_KEY=your_phishtank_api_key_here
THREAT_INTEL_CACHE_TTL=3600

# ------------------------------------------------------------------------------
# 6. Blockchain Web3 Registry (Member 3)
# ------------------------------------------------------------------------------
# EVM JSON-RPC endpoint (Local Hardhat node or Sepolia / Polygon testnet)
WEB3_PROVIDER_URI=http://127.0.0.1:8545
CHAIN_ID=31337

# Deployed ThreatReportRegistry smart contract address
# Leave empty to operate in zero-dependency Simulation Mode
REGISTRY_CONTRACT_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3

# Authorized Registrar Private Key (Account #0 in local Hardhat node)
REGISTRAR_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# Web3 operational timeouts & confirmations
BLOCKCHAIN_TIMEOUT_SECONDS=15
BLOCKCHAIN_CONFIRMATIONS=1

# ------------------------------------------------------------------------------
# 7. Frontend Client Configuration (Vite)
# ------------------------------------------------------------------------------
VITE_API_BASE_URL=http://127.0.0.1:8000/api/v1

